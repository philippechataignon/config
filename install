#!/bin/sh
cp gitconfig        ~/.gitconfig
cp jjconfig.toml    ~/.jjconfig.toml
cp tmux.conf        ~/.tmux.conf
cp vimrc            ~/.vimrc
cp zshrc            ~/.zshrc
cp zlogin           ~/.zlogin
mkdir -p ~/bin
cp -r zsh-jj        ~/bin
for f in jjpa jjpp jjf
do
    cp $f ~/bin
    chmod +x ~/bin/$f
done
mkdir -p ~/.config/helix
cp helix.toml ~/.config/helix/config.toml
